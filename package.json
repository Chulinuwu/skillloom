{
  "name": "@chulinxz/skillloom",
  "version": "0.3.0",
  "description": "Local-first control plane for learning, scanning, promoting, and rolling back portable Agent Skills",
  "type": "module",
  "license": "MIT",
  "author": "Chulinuwu",
  "homepage": "https://github.com/Chulinuwu/skillloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chulinuwu/skillloom.git"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skills",
    "claude-code",
    "codex",
    "local-first",
    "security",
    "rollback",
    "skill-management",
    "self-learning"
  ],
  "bin": {
    "skillloom": "dist/cli/main.js"
  },
  "files": [
    ".agents/plugins",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "assets",
    "dist",
    "hub/Dockerfile",
    "hub/README.md",
    "hub/compose.yaml",
    "hub/.env.example",
    "hub/policy.example.hujson",
    "hub/scripts",
    "hooks",
    "mode-profile.d.mts",
    "mode-profile.mjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts test/adapters/*.test.ts test/cli/*.test.ts test/commands/*.test.ts test/config/*.test.ts test/deployment/*.test.ts test/files/*.test.ts test/hooks/*.test.ts test/hub/*.test.ts test/packaging/*.test.ts test/policy/*.test.ts test/promotions/*.test.ts test/security/*.test.ts test/skills/*.test.ts",
    "validate:plugin": "node test/packaging/validate-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "eslint": "^10.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
