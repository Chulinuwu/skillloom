{
  "name": "@chulinxz/skillloom",
  "version": "0.3.8",
  "description": "Private second brain that shares agent knowledge without letting memory silently become executable instructions",
  "type": "module",
  "license": "MIT",
  "author": "Chulinuwu",
  "homepage": "https://github.com/Chulinuwu/skillloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chulinuwu/skillloom.git"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skills",
    "claude-code",
    "codex",
    "local-first",
    "second-brain",
    "obsidian",
    "tailnet",
    "security",
    "rollback",
    "skill-management",
    "self-learning"
  ],
  "bin": {
    "skillloom": "dist/cli/main.js"
  },
  "files": [
    ".agents/plugins",
    ".claude-plugin",
    ".codex-plugin",
    "claude.mcp.json",
    "codex.mcp.json",
    "assets",
    "dist",
    "docs/architecture",
    "docs/benchmarks.md",
    "docs/comparisons.md",
    "docs/roadmap.md",
    "hub/Dockerfile",
    "hub/README.md",
    "hub/compose.yaml",
    "hub/.env.example",
    "hub/policy.example.hujson",
    "hub/scripts",
    "hooks",
    "mode-profile.d.mts",
    "mode-profile.mjs",
    "plugin-runtime",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:plugin-runtime",
    "build:plugin-runtime": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugin-runtime/skillloom.mjs",
    "lint": "eslint .",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts test/adapters/*.test.ts test/cli/*.test.ts test/commands/*.test.ts test/config/*.test.ts test/deployment/*.test.ts test/files/*.test.ts test/hooks/*.test.ts test/hub/*.test.ts test/packaging/*.test.ts test/policy/*.test.ts test/promotions/*.test.ts test/security/*.test.ts test/skills/*.test.ts",
    "validate:plugin": "node test/packaging/validate-plugin.mjs",
    "demo": "npm run build --silent && node dist/cli/main.js demo",
    "benchmark:retrieval": "npm run build --silent && node dist/cli/main.js benchmark retrieval"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
